# OrgWeave development environment template.
# Copy to .env before running: cp .env.example .env
# NEVER commit .env or real credentials.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Authentication. MUST be replaced outside local development.
JWT_SECRET=orgweave-dev-jwt-secret-change-in-production-please
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_HOURS=72

# ---------------------------------------------------------------------------
# PostgreSQL (pgvector image)
# ---------------------------------------------------------------------------
POSTGRES_USER=orgweave
POSTGRES_PASSWORD=orgweave_dev_password
POSTGRES_DB=orgweave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Application role: non-superuser, subject to Row Level Security.
POSTGRES_APP_USER=orgweave_app
POSTGRES_APP_PASSWORD=orgweave_app_dev_password
DATABASE_URL=postgresql+asyncpg://orgweave_app:orgweave_app_dev_password@localhost:5432/orgweave
# Owner role used only by Alembic migrations.
MIGRATION_DATABASE_URL=postgresql+asyncpg://orgweave:orgweave_dev_password@localhost:5432/orgweave

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Temporal
# ---------------------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=orgweave-phase0

# ---------------------------------------------------------------------------
# LiteLLM gateway
# Master key is a development-only placeholder. Replace in shared environments.
# Provider API keys are optional: without them the gateway and all services
# still start, but real model calls will fail until a provider is configured.
# ---------------------------------------------------------------------------
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-orgweave-dev-master-key
LITELLM_CONFIG_PATH=infra/litellm/config.yaml
# Placeholder model alias configured in infra/litellm/config.yaml.
DEFAULT_MODEL_ALIAS=orgweave-default
# Optional upstream providers (leave empty to keep the service running)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# MinIO / S3-compatible storage
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=orgweave
MINIO_ROOT_PASSWORD=orgweave_dev_minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET=orgweave
S3_ACCESS_KEY=orgweave
S3_SECRET_KEY=orgweave_dev_minio_password

# ---------------------------------------------------------------------------
# Health checks and workers
# ---------------------------------------------------------------------------
HEALTH_CHECK_TIMEOUT_SECONDS=3
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WATCHDOG_STALE_AFTER_SECONDS=45
WATCHDOG_SCAN_INTERVAL_SECONDS=15

# ---------------------------------------------------------------------------
# Web (browser-visible URLs)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws/v1
# Server-side URL used by Next.js; in Docker Compose this is http://api:8000
API_INTERNAL_URL=http://localhost:8000
# Set true only when served over HTTPS.
COOKIE_SECURE=false

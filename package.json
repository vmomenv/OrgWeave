{
  "name": "orgweave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web:dev": "pnpm --filter @orgweave/web dev",
    "web:build": "pnpm --filter @orgweave/web build",
    "web:lint": "pnpm --filter @orgweave/web lint",
    "web:typecheck": "pnpm --filter @orgweave/web typecheck",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build"
  }
}
